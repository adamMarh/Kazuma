{
    "name": "client",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "start": "ng serve --open",
        "start:electron": "ng build --configuration=development --base-href ./ && electron .",
        "build:electron": "ng build --base-href ./ && electron-packager . --asar --ignore=/node_modules --ignore=/.angular --ignore=/e2e --ignore=/src --overwrite --out=./build",
        "build": "ng build",
        "deploy": "ng build",
        "format": "prettier --config ../.prettierrc.yaml --ignore-path ../.prettierignore --write \"src/**/*\"",
        "test": "ng test",
        "coverage": "ng test --code-coverage --source-map=true",
        "lint": "ng lint --format stylish",
        "lint:fix": "npm run lint -- --fix"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "20.3.16",
        "@angular/cdk": "20.2.14",
        "@angular/common": "20.3.16",
        "@angular/compiler": "20.3.16",
        "@angular/core": "20.3.16",
        "@angular/forms": "20.3.16",
        "@angular/material": "20.2.14",
        "@angular/platform-browser": "20.3.16",
        "@angular/platform-browser-dynamic": "20.3.16",
        "@angular/router": "20.3.16",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "firebase": "^12.8.0",
        "html2canvas": "^1.4.1",
        "qrcode": "^1.5.4",
        "rxjs": "7.8.1",
        "socket.io-client": "^4.8.1",
        "tslib": "2.4.0",
        "zone.js": "0.15.0"
    },
    "devDependencies": {
        "@angular-eslint/builder": "20.7.0",
        "@angular-eslint/eslint-plugin": "20.7.0",
        "@angular-eslint/eslint-plugin-template": "20.7.0",
        "@angular-eslint/schematics": "20.7.0",
        "@angular-eslint/template-parser": "20.7.0",
        "@angular/build": "^20.3.14",
        "@angular/cli": "20.3.14",
        "@angular/compiler-cli": "20.3.16",
        "@electron/packager": "^19.0.1",
        "@types/jasmine": "^4.3.5",
        "@types/node": "22.10.2",
        "@types/qrcode": "^1.5.6",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "electron": "^40.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-import-resolver-typescript": "3.6.1",
        "eslint-plugin-import": "2.29.1",
        "eslint-plugin-jsdoc": "46.4.6",
        "eslint-plugin-prettier": "5.1.3",
        "jasmine-core": "5.1.0",
        "karma": "6.4.2",
        "karma-chrome-launcher": "3.2.0",
        "karma-coverage": "2.2.1",
        "karma-jasmine": "5.1.0",
        "karma-jasmine-html-reporter": "2.1.0",
        "prettier": "3.0.1",
        "typescript": "5.9.3"
    }
}
